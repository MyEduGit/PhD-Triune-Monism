FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY hybrid_router/requirements.txt /tmp/req_router.txt
COPY mem0_pilot/requirements.txt    /tmp/req_mem0.txt
COPY cognee_pilot/requirements.txt  /tmp/req_cognee.txt

RUN pip install --no-cache-dir \
    -r /tmp/req_router.txt \
    -r /tmp/req_mem0.txt \
    -r /tmp/req_cognee.txt

COPY . /app

EXPOSE 8765

CMD ["uvicorn", "hybrid_router.server:app", "--host", "0.0.0.0", "--port", "8765"]
